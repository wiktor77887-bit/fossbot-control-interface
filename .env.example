# Copy to .env and adjust:  cp .env.example .env

# --- real robot ---
# Robot running fossbot_agent.py: a .local name (needs Avahi + the mDNS line
# below) or the IP address from the lab instructor.
FOSSBOT_HOST=fossbotrpi1.local
# Resolve .local names through the host's Avahi. Remove this line when
# FOSSBOT_HOST is an IP address or Avahi is not installed.
COMPOSE_FILE=compose.yaml:compose.mdns.yaml
# Domain shared by the bridge and the interface; one per robot/PC pair.
ROS_DOMAIN_ID=1
# Checkout of https://github.com/LRMPUT/fossbot-ros2-bridge (bridge image source).
FOSSBOT_BRIDGE_DIR=../fossbot-ros2-bridge

# --- simulation ---
FOSSBOT_SIM_DIR=../Lab_5/FOSSBotEduSim
SIM_WORLD=simple_shapes.sdf
SIM_ROS_DOMAIN_ID=0

# --- laptop camera (usb_cam -> /user_cam/image_raw) ---
START_CAMERA=true
VIDEO_DEVICE=/dev/video0
# Without a camera:
# START_CAMERA=false
# VIDEO_DEVICE=/dev/null
